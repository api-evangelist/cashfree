          "name": "Verify Name Match",
          "request": {
            "name": "Verify Name Match",
            "description": {
              "content": "Use this API to verify names that have enormous variations. Provide us the names you want to verify, and we will tell you whether they match and provide the reason. View the [test data](https://www.cashfree.com/docs/api-reference/vrs/data-to-test-integration#name-match) and use the information to trigger the validations. The test data are usable only in the test environments such as sandbox.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "name-match"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Send the signature if IP is not whitelisted",
                "key": "x-cf-signature",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-client-id"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_id\": \"ABC00123\",\n  \"name_1\": \"JOHN DOE\",\n  \"name_2\": \"JOHN DOE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
