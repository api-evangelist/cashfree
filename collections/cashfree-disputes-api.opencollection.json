                "value": "47bf8872-46fe-11ee-be56-0242ac120002"
              }
            ],
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-client-id",
              "value": "{{x-client-id}}",
              "placement": "header"
            }
          },
          "docs": "Use this API to get all Dispute details by specifying the Order ID."
